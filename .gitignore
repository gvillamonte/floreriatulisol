# ========================================================
# .gitignore - Florería Tulisol
# ========================================================

# Pruebas y scripts temporales locales
scratch/
test_*.php

# Metadatos locales de agentes y herramientas
.opencode/

# Herramientas de diagnóstico de depuración
diagnostico.php

# Archivos del sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# Editores e IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Logs y temporales
*.log
*.tmp
*.bak

# Variables de entorno y credenciales futuras
.env
.env.local
deploy.php
desplegar.bat

